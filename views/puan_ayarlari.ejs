<%- include('partials/header') %>
<% const fk = form.kural, fo = form.odul;
   const sabitMod = fk.oneri_mod === 'sabit'; %>

<div class="ayar-sayfa">
<div class="list-head">
    <h1 class="page-title">🏆 Puan ve Ödül Ayarları</h1>
    <div class="list-actions">
        <a class="btn ghost" href="/yonetici">← Yönetim</a>
        <a class="btn ghost" href="/puan-durumu">Puan Listesi</a>
    </div>
</div>
<p class="subtitle">Yalnızca ana yönetici değiştirir. Şu an geçerli: <strong><%= kural_metni(guncel) %></strong> ·
    5S → <%= odul.bes.map(puanfmt).join(' / ') %> · ödül eşiği <strong><%= puanfmt(odul.esik) %></strong> puan.</p>

<% if (hatalar.length) { %>
<div class="uyari-kutu ayar-hata"><% for (const h of hatalar) { %><div>⚠ <%= h %></div><% } %></div>
<% } %>

<form method="post" action="/yonetici/puan-ayarlari" class="form-card ayar-form" autocomplete="off">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">

    <h3 class="ayar-baslik">🎁 Ödül</h3>
    <div class="ayar-satir">
        <div class="ayar-ad"><label for="esik">Ödül eşiği</label>
            <small>Net puanı bu değere ulaşan kişiye ödül verilebilir; ödülde bu kadar puan düşülür.
                Daha önce verilmiş ödüller değişmez.</small></div>
        <div class="ayar-deger"><input type="number" id="esik" name="esik" min="1" step="1" value="<%= fo.esik ?? '' %>" required>
            <span class="birim">puan</span></div>
    </div>
    <div class="ayar-satir">
        <div class="ayar-ad"><span class="ayar-etiket">5S turu ödülü</span>
            <small>Turda ilk 3 bölümün ekibindeki her kişiye. Bundan sonra işlenecek turlara uygulanır.</small></div>
        <div class="ayar-deger ayar-uclu">
            <% [['bes1', '1.'], ['bes2', '2.'], ['bes3', '3.']].forEach(function (b, i) { %>
            <label class="kucuk-etiket"><%= b[1] %>
                <input type="number" name="<%= b[0] %>" min="0" step="1" value="<%= fo.bes[i] ?? '' %>" required
                       aria-label="5S <%= b[1] %> bölüm ödülü"></label>
            <% }); %>
            <span class="birim">puan</span>
        </div>
    </div>

    <h3 class="ayar-baslik">💡 Öneri</h3>
    <div class="ayar-satir">
        <div class="ayar-ad"><span class="ayar-etiket">Değerlendirme şekli</span>
            <small>Puanlama tablosu: öneri kaizen gibi puanlanır. Sabit puan: tablo kullanılmaz, öneri onaylanınca puan yazılır.</small></div>
        <div class="ayar-deger">
            <div class="segment" role="radiogroup" aria-label="Öneri değerlendirme şekli">
                <label><input type="radio" name="oneri_mod" value="tablo" <%= !sabitMod ? 'checked' : '' %>> Puanlama tablosu</label>
                <label><input type="radio" name="oneri_mod" value="sabit" <%= sabitMod ? 'checked' : '' %>> Sabit puan</label>
            </div>
        </div>
    </div>
    <div class="ayar-satir" data-oneri-mod="tablo"<%= sabitMod ? ' hidden' : '' %>>
        <div class="ayar-ad"><label for="oneri_oran">Sahibine yazılan pay</label>
            <small>Puanlama tablosundaki puanın yüzdesi. Örnek: 80 puanlık öneri × %<%= puanfmt(fk.oneri_oran || 0) %> = <%= puanfmt(80 * (fk.oneri_oran || 0) / 100) %> puan.</small></div>
        <div class="ayar-deger"><span class="birim">%</span>
            <input type="number" id="oneri_oran" name="oneri_oran" min="0" max="100" step="0.5" value="<%= fk.oneri_oran ?? '' %>"></div>
    </div>
    <div class="ayar-satir" data-oneri-mod="sabit"<%= !sabitMod ? ' hidden' : '' %>>
        <div class="ayar-ad"><label for="oneri_sabit">Onaylanınca yazılan puan</label>
            <small>Öneri onaylandığı an sahibine yazılır; "Puanla" düğmesi görünmez.</small></div>
        <div class="ayar-deger"><input type="number" id="oneri_sabit" name="oneri_sabit" min="0" max="1000" step="0.5" value="<%= fk.oneri_sabit ?? '' %>">
            <span class="birim">puan</span></div>
    </div>

    <h3 class="ayar-baslik">🔧 Kaizen <small>(her zaman puanlama tablosuyla)</small></h3>
    <div class="ayar-satir">
        <div class="ayar-ad"><label for="kaizen_lider_oran">Lidere yazılan pay</label>
            <small>Kaizen puanının yüzdesi.</small></div>
        <div class="ayar-deger"><span class="birim">%</span>
            <input type="number" id="kaizen_lider_oran" name="kaizen_lider_oran" min="0" max="100" step="0.5" value="<%= fk.kaizen_lider_oran ?? '' %>" required></div>
    </div>
    <div class="ayar-satir">
        <div class="ayar-ad"><label for="kaizen_uye_oran">Her üyeye yazılan pay</label>
            <small>Örnek: 100 puanlık kaizende lider <%= puanfmt(fk.kaizen_lider_oran || 0) %>, her üye <%= puanfmt(fk.kaizen_uye_oran || 0) %> puan alır.</small></div>
        <div class="ayar-deger"><span class="birim">%</span>
            <input type="number" id="kaizen_uye_oran" name="kaizen_uye_oran" min="0" max="100" step="0.5" value="<%= fk.kaizen_uye_oran ?? '' %>" required></div>
    </div>

    <h3 class="ayar-baslik">📅 Öneri ve kaizen değişikliği hangi kayıtlara uygulansın?</h3>
    <div class="secenek-liste">
        <label><input type="radio" name="uygulama" value="ileri" <%= !form.geriyeDonuk ? 'checked' : '' %>>
            <span><strong>Bugünden itibaren onaylananlara <em>(önerilen)</em></strong>
                <small>Daha önce onaylanmış kayıtların puanı değişmez.</small></span></label>
        <label><input type="radio" name="uygulama" value="geri" <%= form.geriyeDonuk ? 'checked' : '' %>>
            <span><strong>Tüm kayıtlara (geriye dönük)</strong>
                <small class="uyari-yazi">Bütün öneri ve kaizen puanları yeniden hesaplanır; ödül almış kişilerin net puanı düşebilir. Önce önizleyin.</small></span></label>
    </div>

    <div class="ayar-butonlar">
        <button type="submit" name="islem" value="onizle" class="btn ghost">👁 Etkisini Önizle</button>
        <button type="submit" name="islem" value="kaydet" class="btn primary"
                onclick="return confirm(this.dataset.onay)" data-onay="Puan ve ödül ayarları kaydedilecek. Devam?">💾 Kaydet</button>
    </div>
</form>

<% if (onizleme) { const o = onizleme; %>
<h2 class="bolum-baslik" id="onizleme">👁 Önizleme — mevcut veride etkisi (henüz kaydedilmedi)</h2>
<% if (!o.kuralDegisti && !o.esikDegisti && !o.besDegisti) { %>
<p class="bos-not">Değişiklik yok.</p>
<% } else { %>
<div class="kural-kutu">
    <% if (o.kuralDegisti && !o.geriyeDonuk) { %>Öneri/kaizen kuralı <b>bugünden itibaren</b> onaylanan kayıtlara uygulanacağı için mevcut puanlar değişmez; yalnızca bugün onaylanmış kayıtlar yeni kuralla hesaplanır.<br><% } %>
    <% if (o.kuralDegisti && o.geriyeDonuk) { %>Öneri/kaizen kuralı <b>tüm kayıtlara</b> uygulanacak: aşağıdaki fark gerçek etkidir.<br><% } %>
    <% if (o.esikDegisti) { %>Ödül eşiği <b><%= puanfmt(o.esik_once) %> → <%= puanfmt(o.esik_sonra) %></b>.<br><% } %>
    <% if (o.besDegisti) { %>5S tur ödülleri yalnız bundan sonra işlenecek turları etkiler; bu önizlemede görünmez.<% } %>
</div>
<div class="table-wrap">
<table class="data-table mini-tablo onizleme-tablo">
    <thead><tr><th>Toplam</th><th>Şu an</th><th>Yeni ayarla</th><th>Fark</th></tr></thead>
    <tbody>
        <% [['Öneri puanı', 'oneri'], ['Kaizen puanı', 'kaizen'], ['5S puanı', 'bes'], ['Toplam kazanılan', 'kazanilan'],
            ['Eşiği geçen kişi', 'esigi_gecen'], ['Verilebilecek ödül', 'olasi_odul']].forEach(function (m) {
            const a = o.once[m[1]], b = o.sonra[m[1]], f = Math.round((b - a) * 100) / 100; %>
        <tr><td data-label="Toplam"><strong><%= m[0] %></strong></td>
            <td data-label="Şu an"><%= puanfmt(a) %></td>
            <td data-label="Yeni ayarla"><%= puanfmt(b) %></td>
            <td data-label="Fark" class="<%= f > 0 ? 's-iyi' : (f < 0 ? 's-dusuk' : '') %>"><%= f ? (f > 0 ? '+' : '') + puanfmt(f) : '—' %></td></tr>
        <% }); %>
    </tbody>
</table>
</div>
<% if (o.degisen.length) { %>
<h3 class="alt-baslik">Net puanı veya ödül durumu değişen kişiler (<%= o.degisen_sayisi %>)</h3>
<div class="table-wrap">
<table class="data-table mini-tablo">
    <thead><tr><th>Personel</th><th>Şu an net</th><th>Yeni net</th><th>Fark</th><th>Ödül durumu</th></tr></thead>
    <tbody>
        <% for (const k of o.degisen) { %>
        <tr><td data-label="Personel"><strong><%= k.ad %></strong></td><td data-label="Şu an net"><%= puanfmt(k.once) %></td><td data-label="Yeni net"><%= puanfmt(k.sonra) %></td>
            <td data-label="Fark" class="<%= k.fark > 0 ? 's-iyi' : (k.fark < 0 ? 's-dusuk' : '') %>"><%= k.fark > 0 ? '+' : '' %><%= puanfmt(k.fark) %></td>
            <td data-label="Ödül durumu"><%= k.gecO === k.gecS ? (k.gecS ? 'eşiğin üstünde (değişmiyor)' : '—') : (k.gecS ? '✓ eşiği geçiyor' : '✗ eşiğin altına iniyor') %></td></tr>
        <% } %>
    </tbody>
</table>
</div>
<% if (o.degisen_sayisi > o.degisen.length) { %><p class="bos-not">… ve <%= o.degisen_sayisi - o.degisen.length %> kişi daha.</p><% } %>
<% } else { %><p class="bos-not">Hiçbir kişinin net puanı veya ödül durumu değişmiyor.</p><% } %>
<p class="bos-not">Önizleme kaydedilmedi. Uygun görürseniz yukarıdaki <strong>💾 Kaydet</strong> ile kaydedin.</p>
<% } %>
<% } %>

<h2 class="bolum-baslik">🗂 Öneri ve kaizen kuralı geçmişi</h2>
<p class="bos-not">Her kayda, <strong>onaylandığı gün</strong> geçerli olan kural uygulanır (eski kayıtlarda onay tarihi yoksa kayıt tarihi).</p>
<div class="table-wrap">
<table class="data-table mini-tablo">
    <thead><tr><th>Geçerlilik</th><th>Öneri</th><th>Kaizen</th><th>Kaydeden</th><th></th></tr></thead>
    <tbody>
        <% surumler.slice().reverse().forEach(function (s, i) { %>
        <tr>
            <td data-label="Geçerlilik" class="nowrap"><%= s.gecerlilik === baslangic ? 'Başlangıçtan' : trdate(s.gecerlilik) + "'den" %> itibaren
                <% if (s === guncel) { %><span class="durum-badge onay">şu an</span><% } %></td>
            <td data-label="Öneri"><%= s.oneri_mod === 'sabit' ? 'onaylanınca sabit ' + puanfmt(s.oneri_sabit) + ' puan' : 'tablo × %' + puanfmt(s.oneri_oran) %></td>
            <td data-label="Kaizen">lider %<%= puanfmt(s.kaizen_lider_oran) %> · üye %<%= puanfmt(s.kaizen_uye_oran) %></td>
            <td data-label="Kaydeden"><%= s.kaydeden || (s.gecerlilik === baslangic && !s.zaman ? 'varsayılan' : '—') %><% if (s.zaman) { %><br><small class="bos-not"><%= s.zaman %></small><% } %></td>
            <td><% if (s.gecerlilik !== baslangic) { %>
                <form method="post" action="/yonetici/puan-ayarlari/surum-sil" style="display:inline"
                      onsubmit="return confirm(this.dataset.onay)" data-onay="<%= trdate(s.gecerlilik) %> tarihli kural kaldırılacak; o tarihten sonra onaylanan kayıtlara bir önceki kural uygulanır. Devam?">
                    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                    <input type="hidden" name="gecerlilik" value="<%= s.gecerlilik %>">
                    <button type="submit" class="btn-mini del">Kaldır</button>
                </form>
            <% } %></td>
        </tr>
        <% }); %>
    </tbody>
</table>
</div>
</div>

<script>
// Öneri değerlendirme şekline göre ilgili satırı göster (gizli alan da gönderilir; sunucu doğrular)
(function () {
    var radyolar = document.querySelectorAll('input[name="oneri_mod"]');
    function guncelle() {
        var secili = document.querySelector('input[name="oneri_mod"]:checked');
        document.querySelectorAll('[data-oneri-mod]').forEach(function (satir) {
            satir.hidden = !secili || satir.getAttribute('data-oneri-mod') !== secili.value;
        });
    }
    radyolar.forEach(function (r) { r.addEventListener('change', guncelle); });
})();
</script>
<%- include('partials/footer') %>
