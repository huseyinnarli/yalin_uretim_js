<%- include('partials/header') %>
<h1 class="page-title"><%- ik('wrench') %> <%= duzenle ? "Kaizen Düzenle" : "Yeni Kaizen Formu" %></h1>
<% if (kayit.kaynak_oneri_no && !duzenle) { %>
<div class="gorev-kutu"><strong><%- ik('lightbulb') %> <%= kayit.kaynak_oneri_no %> önerisi kaizene dönüştürülüyor.</strong>
    <small>Konu ve açıklamalar öneriden aktarıldı; uygulamaya göre düzenleyip fotoğrafları ekleyin.</small></div>
<% } %>
<% if (duzenle && kayit.durum == 'Düzeltme İsteniyor' && kayit.revize_notu) { %>
<div class="gorev-kutu"><strong><%- ik('pencil') %> İstenen düzeltme:</strong> <%= kayit.revize_notu %>
    <small>Kaydettiğinizde kaizen yeniden değerlendirmeye gönderilir.</small></div>
<% } %>
<% if (duzenle) { %>
<p class="subtitle">Kaizen No: <strong class="mono"><%= kayit.no %></strong> (numara değişmez).</p>
<% } else { %>
<p class="subtitle">Kaizen numarası kayıt sırasında otomatik atanır (örn. ÖSKFR2606-01).</p>
<% } %>

<form class="form-card" method="post" action="<%= action_url %>" enctype="multipart/form-data" autocomplete="off"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <% if (kayit.kaynak_oneri_no && !duzenle) { %><input type="hidden" name="kaynak_oneri" value="<%= kayit.kaynak_oneri_no %>"><% } %>
    <div class="row">
        <div class="field small">
            <label>Başlangıç Tarihi *</label>
            <input type="date" name="baslangic" value="<%= kayit.baslangic || bugun %>" required>
        </div>
        <div class="field small">
            <label>Bitiş Tarihi</label>
            <input type="date" name="bitis" value="<%= kayit.bitis || '' %>">
        </div>
    </div>

    <div class="row">
        <div class="field">
            <label>Kaizen Konusu *</label>
            <input type="text" name="konu" required value="<%= kayit.konu || '' %>" placeholder="Örn. Montaj hattı setup süresinin kısaltılması">
        </div>
        <%- include('partials/liste_secimi', { alan_adi: 'bolum', etiket: 'Yapıldığı Bölüm', secenekler: bolum_secenekleri,
              secili: kayit.bolum, mevcut: mevcut.bolum, zorunlu: true, bos_yazi: '— Bölüm seçin —',
              serbest: { zorunlu: false, placeholder: 'Örn. Montaj Hattı 2' } }) %>
    </div>

    <fieldset class="ekip">
        <legend>Ekip (en fazla 3 kişi) — ad ve soyadı ayrı kutulara yazın</legend>
        <% const uy = kayit.uyeler || [], ug = kayit.uye_gorevleri || [], mug = mevcut.uye_gorevleri || [];
           const kisiler = [
             { onek: 'lider', etiket: 'Kaizen Lideri *', not: 'puanın %' + puanfmt(kural.kaizen_lider_oran), v: adBol(kayit.lider || ''), zorunlu: true,
               gorev: kayit.lider_gorevi, mevcut_gorev: mevcut.lider_gorevi },
             { onek: 'uye1', etiket: 'Üye 2', not: 'puanın %' + puanfmt(kural.kaizen_uye_oran), v: adBol(uy[0] || ''), zorunlu: false,
               gorev: ug[0], mevcut_gorev: mug[0] },
             { onek: 'uye2', etiket: 'Üye 3', not: 'puanın %' + puanfmt(kural.kaizen_uye_oran), v: adBol(uy[1] || ''), zorunlu: false,
               gorev: ug[1], mevcut_gorev: mug[1] },
           ]; %>
        <% for (const k of kisiler) { %>
        <div class="row ekip-satir">
            <div class="field">
                <label><%= k.etiket %> — Ad <small>(<%= k.not %>)</small></label>
                <input type="text" name="<%= k.onek %>_ad" value="<%= k.v.ad %>" <%= k.zorunlu ? 'required' : '' %>
                       placeholder="<%= k.zorunlu ? 'Örn. Ahmet' : 'Opsiyonel' %>">
            </div>
            <div class="field">
                <label>Soyad<%= k.zorunlu ? ' *' : '' %></label>
                <input type="text" name="<%= k.onek %>_soyad" value="<%= k.v.soyad %>" <%= k.zorunlu ? 'required' : '' %>
                       placeholder="<%= k.zorunlu ? 'Örn. Yılmaz' : 'Opsiyonel' %>">
            </div>
            <%# Görev listesi tanımlıysa her kişinin görevi seçilir (üyede, üye yazıldıysa zorunlu — sunucu denetler) %>
            <%- include('partials/liste_secimi', { alan_adi: k.onek + '_gorevi', etiket: 'Görevi', secenekler: gorev_secenekleri,
                  secili: k.gorev, mevcut: k.mevcut_gorev, zorunlu: k.zorunlu,
                  bos_yazi: k.zorunlu ? '— Görev seçin —' : '— Üye yazıldıysa seçin —' }) %>
        </div>
        <% } %>
    </fieldset>

    <fieldset class="kazanc">
        <legend>Kazanç Başlıkları (bir veya birkaçını seçin)</legend>
        <div class="checkbox-grid">
            <% for (const k of kazanc_basliklari) { %>
            <label class="chk">
                <input type="checkbox" name="kazanclar" value="<%= k %>"
                    <%= (kayit.kazanclar && kayit.kazanclar.includes(k)) ? 'checked' : '' %>>
                <span><%= k %></span>
            </label>
            <% } %>
        </div>
    </fieldset>

    <div class="row prepost">
        <div class="field">
            <label>Önceki Durum (Açıklama) *</label>
            <textarea name="onceki" rows="4" required placeholder="İyileştirme öncesi durumu açıklayın"><%= kayit.onceki || '' %></textarea>
            <label for="onceki_maliyet">Önceki Durum Maliyeti (€) *</label>
            <div class="para-kutu"><input type="text" id="onceki_maliyet" name="onceki_maliyet" inputmode="decimal" required
                autocomplete="off" placeholder="ör. 1250,50" data-maliyet value="<%= kayit.onceki_maliyet ?? '' %>"><span>€</span></div>
            <label class="file-label">Önceki Durum Görseli</label>
            <% if (kayit.onceki_gorsel) { %>
            <div class="mevcut-gorsel">
                <img loading="lazy" src="/kaizen/gorsel/<%= encodeURIComponent(kayit.onceki_gorsel) %>" alt="mevcut önce">
                <span>Mevcut görsel. Değiştirmek için yeni dosya seçin.</span>
            </div>
            <% } %>
            <input type="file" name="onceki_gorsel" accept="image/*">
        </div>
        <div class="field">
            <label>Sonraki Durum (Açıklama) *</label>
            <textarea name="sonraki" rows="4" required placeholder="İyileştirme sonrası durumu açıklayın"><%= kayit.sonraki || '' %></textarea>
            <label for="sonraki_maliyet">Sonraki Durum Maliyeti (€) *</label>
            <div class="para-kutu"><input type="text" id="sonraki_maliyet" name="sonraki_maliyet" inputmode="decimal" required
                autocomplete="off" placeholder="ör. 900" data-maliyet value="<%= kayit.sonraki_maliyet ?? '' %>"><span>€</span></div>
            <label class="file-label">Sonraki Durum Görseli</label>
            <% if (kayit.sonraki_gorsel) { %>
            <div class="mevcut-gorsel">
                <img loading="lazy" src="/kaizen/gorsel/<%= encodeURIComponent(kayit.sonraki_gorsel) %>" alt="mevcut sonra">
                <span>Mevcut görsel. Değiştirmek için yeni dosya seçin.</span>
            </div>
            <% } %>
            <input type="file" name="sonraki_gorsel" accept="image/*">
        </div>
    </div>
    <p class="maliyet-sonuc" id="maliyet-sonuc" aria-live="polite"></p>
    <p class="bos-not maliyet-not"><%- ik('euro') %> Maliyet hesabı: iki durumu <strong>aynı dönem</strong> için girin (ör. yıllık). Fark
        (önceki − sonraki) kazancı ya da zararı gösterir. Maliyet yoksa 0 yazın.</p>
    <script>
    // Maliyet farkının canlı gösterimi (sunucu da aynı kuralla doğrular: yardimci.js paraOku)
    (function () {
        var kutular = document.querySelectorAll('[data-maliyet]'), sonuc = document.getElementById('maliyet-sonuc');
        var EURO = '<%- ik('euro') %>';
        function oku(v) {
            var s = String(v || '').replace(/[\s€]/g, '');
            if (!s) return null;
            if (s.indexOf(',') >= 0) s = s.replace(/\./g, '').replace(',', '.');
            return /^\d+(\.\d{1,2})?$/.test(s) ? Number(s) : NaN;
        }
        function fmt(n) { return n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €'; }
        function guncelle() {
            var o = oku(kutular[0].value), s = oku(kutular[1].value);
            sonuc.className = 'maliyet-sonuc';
            if (o === null || s === null) { sonuc.textContent = ''; return; }
            if (isNaN(o) || isNaN(s)) { sonuc.textContent = 'Maliyet sayı olmalı (ör. 1250,50).'; sonuc.className += ' zarar'; return; }
            var f = Math.round((o - s) * 100) / 100;
            // Metin yalnız sayılardan üretilir (kullanıcı metni yok) → innerHTML güvenli
            sonuc.innerHTML = EURO + ' ' + (f > 0 ? 'Kazanç: ' + fmt(f) : (f < 0 ? 'Zarar: ' + fmt(-f) : 'Maliyet farkı yok (0,00 €)'));
            sonuc.className += f > 0 ? ' kazanc' : (f < 0 ? ' zarar' : '');
        }
        for (var i = 0; i < kutular.length; i++) kutular[i].addEventListener('input', guncelle);
        guncelle();
    })();
    </script>

    <div class="form-actions">
        <button type="submit" class="btn primary"><%= duzenle ? "Değişiklikleri Kaydet" : "Kaizeni Kaydet" %></button>
        <a class="btn ghost" href="<%= duzenle ? '/detay?tip=kaizen&no=' + encodeURIComponent(kayit.no) + (geri ? '&geri=' + encodeURIComponent(geri) : '') : (kayit.kaynak_oneri_no ? '/detay?tip=oneri&no=' + encodeURIComponent(kayit.kaynak_oneri_no) : '/') %>">İptal</a>
    </div>
</form>
<%- include('partials/footer') %>
