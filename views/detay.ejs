<%- include('partials/header') %>
<% const d = r.durum || 'Değerlendiriliyor';
   const detayGeri = '&geri=' + encodeURIComponent(geri);
   const benimRevizem = !silinen && denetmen && d == 'Düzeltme İsteniyor' && r.revize_atanan_id == denetmen.id; %>

<div class="list-head">
    <h1 class="page-title">
        <% if (tip == 'kaizen') { %>🔧 Kaizen Detayı<% } else { %>💡 Öneri Detayı<% } %>
    </h1>
    <div class="list-actions">
        <a class="btn ghost" href="<%= geri %>">← <%= silinen ? 'Arşive Dön' : 'Listeye Dön' %></a>
        <% if (duzenleyebilir) { %>
        <a class="btn primary" href="/<%= tip %>/duzenle?no=<%= encodeURIComponent(r.no) %><%= detayGeri %>">✏ Düzenle</a>
        <% } %>
        <% if (!silinen && yetki('puanla') && d == 'Onaylandı') { %>
        <a class="btn primary" href="/degerlendir/puan?tip=<%= tip %>&no=<%= encodeURIComponent(r.no) %><%= detayGeri %>">★ <%= r.puanlama ? 'Puanı Düzenle' : 'Puanla' %></a>
        <% } %>
        <% if (donusturebilir) { %>
        <a class="btn primary" href="/kaizen/yeni?oneri=<%= encodeURIComponent(r.no) %>">🔧 Kaizene Dönüştür</a>
        <% } %>
    </div>
</div>

<% if (silinen) { %>
<div class="uyari-kutu">🗑 Bu kayıt <strong><%= silinen.silme_zamani %></strong> tarihinde <strong><%= silinen.silen %></strong>
    tarafından silindi — yalnızca görüntüleniyor.
    <% if (yetki('kayit')) { %>
    <form method="post" action="/silinenler/geri" style="display:inline"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="id" value="<%= silinen.id %>">
        <button type="submit" class="btn-mini onay">↩ Geri Yükle</button>
    </form>
    <% } %>
</div>
<% } %>

<% if (benimRevizem) { %>
<div class="gorev-kutu">
    <strong>✏ Bu kaydın düzeltmesi size atandı.</strong>
    <p><%= r.revize_notu %></p>
    <small>İsteyen: <%= r.revize_isteyen || '—' %> · <%= r.revize_zamani || '' %></small>
    <div><a class="btn primary" href="/<%= tip %>/duzenle?no=<%= encodeURIComponent(r.no) %><%= detayGeri %>">Düzeltmeyi Yap</a></div>
</div>
<% } %>

<div class="detail-card">
    <div class="detail-top">
        <span class="mono badge"><%= r.no %></span>
        <% if (r.form_no) { %><span class="mono badge form-no-badge">Form No: <%= r.form_no %></span><% } %>
        <% if (tip == 'kaizen') { %><span class="tip-badge kaizen">KAIZEN</span>
        <% } else { %><span class="tip-badge oneri">ÖNERİ</span><% } %>
        <% if (d == 'Onaylandı') { %><span class="durum-badge onay"><%= d %></span>
        <% } else if (d == 'Reddedildi') { %><span class="durum-badge red"><%= d %></span>
        <% } else if (d == 'Düzeltme İsteniyor') { %><span class="durum-badge revize"><%= d %></span>
        <% } else { %><span class="durum-badge bekle"><%= d %></span><% } %>
        <% if (r.puan !== null && r.puan !== '' && r.puan !== undefined) { %>
            <span class="puan-badge">Puan: <%= r.puan %></span>
        <% } %>
    </div>

    <% if (tip == 'oneri') { %>
    <h2 class="detail-konu"><%= r.konu %></h2>
    <div class="detail-grid">
        <div><span class="dl">Öneri Sahibi</span><span class="dv"><%= r.sahibi %></span></div>
        <div><span class="dl">Görevi</span><span class="dv"><%= r.gorevi %></span></div>
        <div><span class="dl">Tarih</span><span class="dv"><%= trdate(r.tarih) %></span></div>
        <div><span class="dl">Kayıt</span><span class="dv"><%= r.kayit_zamani %></span></div>
    </div>

    <div class="detail-block"><h3>Detay Açıklama</h3><p><%= r.detay || '—' %></p></div>
    <div class="detail-block"><h3>Çözüm Önerisi</h3><p><%= r.cozum || '—' %></p></div>

    <div class="katki-grid">
        <div class="katki"><h4>1 · Kaliteye Katkısı</h4><p><%= r.kalite || '—' %></p></div>
        <div class="katki"><h4>2 · Verimliliğe Katkısı</h4><p><%= r.verimlilik || '—' %></p></div>
        <div class="katki"><h4>3 · İSG'ye Katkısı</h4><p><%= r.isg || '—' %></p></div>
        <div class="katki"><h4>4 · Maliyete Katkısı</h4><p><%= r.maliyet || '—' %></p></div>
    </div>
    <div class="detail-block"><h3>Ek Açıklama</h3><p><%= r.ek || '—' %></p></div>

    <% } else { %>
    <h2 class="detail-konu"><%= r.konu %></h2>
    <div class="detail-grid">
        <div><span class="dl">Başlangıç</span><span class="dv"><%= trdate(r.baslangic) %></span></div>
        <div><span class="dl">Bitiş</span><span class="dv"><%= trdate(r.bitis) || '—' %></span></div>
        <div><span class="dl">Yapıldığı Bölüm</span><span class="dv"><%= r.bolum || '—' %></span></div>
        <div><span class="dl">Kaizen Lideri</span><span class="dv"><%= r.lider || r.sorumlular || '—' %></span></div>
        <div><span class="dl">Üyeler</span><span class="dv"><%= (r.uyeler && r.uyeler.length) ? r.uyeler.join(', ') : '—' %></span></div>
        <div><span class="dl">Kayıt</span><span class="dv"><%= r.kayit_zamani %></span></div>
    </div>

    <% if (r.kazanclar && r.kazanclar.length) { %>
    <div class="detail-block">
        <h3>Kazanç Başlıkları</h3>
        <div class="tags"><% for (const k of r.kazanclar) { %><span class="tag"><%= k %></span><% } %></div>
    </div>
    <% } %>

    <div class="prepost-grid">
        <div class="pp-col">
            <div class="pp-label before">ÖNCEKİ DURUM</div>
            <p><%= r.onceki || '—' %></p>
            <% if (r.onceki_gorsel) { %>
            <a href="/kaizen/gorsel/<%= encodeURIComponent(r.onceki_gorsel) %>" target="_blank">
                <img loading="lazy" src="/kaizen/gorsel/<%= encodeURIComponent(r.onceki_gorsel) %>" alt="önce">
            </a>
            <% } %>
        </div>
        <div class="pp-col">
            <div class="pp-label after">SONRAKİ DURUM</div>
            <p><%= r.sonraki || '—' %></p>
            <% if (r.sonraki_gorsel) { %>
            <a href="/kaizen/gorsel/<%= encodeURIComponent(r.sonraki_gorsel) %>" target="_blank">
                <img loading="lazy" src="/kaizen/gorsel/<%= encodeURIComponent(r.sonraki_gorsel) %>" alt="sonra">
            </a>
            <% } %>
        </div>
    </div>
    <% } %>

    <% if (r.puanlama) { const pz = r.puanlama;
       const temel = ('temel' in pz) ? pz.temel : ((pz.form || 0) + (pz.komite || 0)); %>
    <div class="detail-block">
        <h3>Puanlama Kırılımı — <%= pz.toplam %>/100</h3>
        <table class="puan-ozet-tablo">
            <tr><td>Temel Şartlar</td><td><%= temel %> / 10</td></tr>
            <tr><td>Etki Odağı<% if (pz.etki_odak) { %> <small>(<%= pz.etki_odak %>)</small><% } else if (pz.etki_label) { %> <small>(<%= pz.etki_label %>)</small><% } %></td><td><%= pz.etki || 0 %> / 40</td></tr>
            <tr><td>Maliyet ve Yatırım<% if (pz.maliyet_label) { %> <small>(<%= pz.maliyet_label %>)</small><% } %></td><td><%= pz.maliyet || 0 %> / 20</td></tr>
            <tr><td>Yaygınlaştırma<% if (pz.yaygin_label) { %> <small>(<%= pz.yaygin_label %>)</small><% } %></td><td><%= pz.yaygin || 0 %> / 15</td></tr>
            <tr><td>Efor ve Sahiplenme<% if (pz.efor_label) { %> <small>(<%= pz.efor_label %>)</small><% } %></td><td><%= pz.efor || 0 %> / 15</td></tr>
            <tr class="ozet-toplam"><td>TOPLAM</td><td><%= pz.toplam %> / 100</td></tr>
        </table>
    </div>
    <% } %>

    <% if (r.degerlendirme_notu) { %>
    <div class="detail-block"><h3>Değerlendirme Notu</h3><p><%= r.degerlendirme_notu %></p></div>
    <% } %>

    <% if (d == 'Reddedildi' && r.red_nedeni) { %>
    <div class="detail-block red-blok"><h3>✕ Red Nedeni</h3><p><%= r.red_nedeni %></p></div>
    <% } %>

    <% if (r.revize_notu) { %>
    <div class="detail-block"><h3>✏ Düzeltme Talebi</h3>
        <p><%= r.revize_notu %></p>
        <small class="bos-not">Atanan: <strong><%= r.revize_atanan_ad || '—' %></strong> · İsteyen: <%= r.revize_isteyen || '—' %>
            · <%= r.revize_zamani || '' %><% if (r.revize_tamamlandi) { %> · ✔ Düzeltildi: <%= r.revize_tamamlandi %><% } %></small>
    </div>
    <% } %>

    <% if (tip == 'oneri' && (r.gorev_atanan_ad || r.kaizen_no)) { %>
    <div class="detail-block"><h3>📌 Uygulama Görevi</h3>
        <% if (r.gorev_atanan_ad) { %>
        <p><strong><%= r.gorev_atanan_ad %></strong><% if (r.gorev_termin) { %> · Termin: <%= trdate(r.gorev_termin) %><% } %></p>
        <% if (r.gorev_notu) { %><p><%= r.gorev_notu %></p><% } %>
        <small class="bos-not">Atayan: <%= r.gorev_atayan || '—' %> · <%= r.gorev_zamani || '' %></small>
        <% } %>
        <% if (r.kaizen_no) { %>
        <p>✔ Kaizene dönüştürüldü: <a href="/detay?tip=kaizen&no=<%= encodeURIComponent(r.kaizen_no) %>" class="mono"><%= r.kaizen_no %></a></p>
        <% } else if (r.gorev_atanan_ad) { %><p class="bos-not">⏳ Henüz kaizene dönüştürülmedi.</p><% } %>
    </div>
    <% } %>

    <% if (tip == 'kaizen' && r.kaynak_oneri_no) { %>
    <div class="detail-block"><h3>💡 Kaynak Öneri</h3>
        <p>Bu kaizen <a href="/detay?tip=oneri&no=<%= encodeURIComponent(r.kaynak_oneri_no) %>" class="mono"><%= r.kaynak_oneri_no %></a> önerisinden dönüştürüldü.</p>
    </div>
    <% } %>

    <% if (r.guncelleme_zamani) { %>
    <div class="kc-foot">Son güncelleme: <%= r.guncelleme_zamani %></div>
    <% } %>
</div>

<% if (!silinen && yetki('degerlendir')) { %>
<h2 class="bolum-baslik" id="degerlendir">⚖ Değerlendirme</h2>
<% const denetmenSecim = (ad, secili) => denetmenler.map((dm) =>
     '<option value="' + dm.id + '"' + (dm.id === secili ? ' selected' : '') + '>' +
     String(dm.ad).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;') + '</option>').join(''); %>
<% if (!denetmenler.length) { %>
<p class="uyari-kutu">Düzeltme veya görev atamak için önce <a href="/yonetici#denetmenler">Yönetim › Denetmenler</a>'den denetmen hesabı açın.</p>
<% } %>
<div class="degerlendir-grid">
    <% if (d != 'Onaylandı') { %>
    <form method="post" action="/durum" class="panel degerlendir-kart onay-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Onaylandı"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3>✓ Onayla</h3>
        <% if (tip == 'oneri') { %>
        <p class="bos-not">İsterseniz uygulayıp kaizene dönüştürecek kişiyi şimdi atayın:</p>
        <select name="gorev_denetmen"><option value="">— görev atama (isteğe bağlı) —</option><%- denetmenSecim() %></select>
        <input type="date" name="gorev_termin" title="Termin (isteğe bağlı)">
        <textarea name="gorev_notu" rows="2" placeholder="Görev notu (isteğe bağlı)"></textarea>
        <% } else { %>
        <p class="bos-not">Onaylanınca form numarası atanır; ardından puanlanabilir.</p>
        <% } %>
        <button type="submit" class="btn primary">✓ Onayla</button>
    </form>

    <% if (d != 'Reddedildi') { %>
    <form method="post" action="/durum" class="panel degerlendir-kart red-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Reddedildi"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3>✕ Reddet</h3>
        <textarea name="red_nedeni" rows="3" required placeholder="Red nedeni — zorunlu"></textarea>
        <button type="submit" class="btn-mini reddet">✕ Reddet</button>
    </form>
    <% } else { %>
    <form method="post" action="/durum" class="panel degerlendir-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Değerlendiriliyor"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3>↩ Değerlendirmeye Geri Al</h3>
        <p class="bos-not">Reddedilen kayıt yeniden "Değerlendiriliyor" durumuna alınır.</p>
        <button type="submit" class="btn-mini edit">↩ Geri Al</button>
    </form>
    <% } %>

    <% if (denetmenler.length) { %>
    <form method="post" action="/durum" class="panel degerlendir-kart revize-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Düzeltme İsteniyor"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3>✏ Düzeltme İste<%= d == 'Düzeltme İsteniyor' ? ' (yeniden ata)' : '' %></h3>
        <select name="revize_denetmen" required><option value="">— düzeltmeyi yapacak denetmen —</option><%- denetmenSecim(null, r.revize_atanan_id) %></select>
        <textarea name="revize_notu" rows="3" required placeholder="Neyin düzeltilmesi gerekiyor — zorunlu"><%= d == 'Düzeltme İsteniyor' ? (r.revize_notu || '') : '' %></textarea>
        <button type="submit" class="btn-mini revize">✏ Düzeltme İste</button>
    </form>
    <% } %>
    <% } else if (tip == 'oneri' && !r.kaizen_no && denetmenler.length) { %>
    <form method="post" action="/gorev" class="panel degerlendir-kart onay-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="no" value="<%= r.no %>"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3>📌 <%= r.gorev_atanan_id ? 'Görevi Değiştir' : 'Uygulama Görevi Ata' %></h3>
        <p class="bos-not">Atanan kişi öneriyi uygular ve kaizene dönüştürür.</p>
        <select name="gorev_denetmen" required><option value="">— denetmen seçin —</option><%- denetmenSecim(null, r.gorev_atanan_id) %></select>
        <input type="date" name="gorev_termin" value="<%= r.gorev_termin || '' %>" title="Termin (isteğe bağlı)">
        <textarea name="gorev_notu" rows="2" placeholder="Görev notu (isteğe bağlı)"><%= r.gorev_notu || '' %></textarea>
        <button type="submit" class="btn primary">📌 Kaydet</button>
        <% if (r.gorev_atanan_id) { %>
        <button type="submit" name="kaldir" value="1" class="btn-mini del" formnovalidate>Görevi Kaldır</button>
        <% } %>
    </form>
    <% } %>
</div>
<% } %>

<% if (!silinen && yetki('kayit')) { %>
<form method="post" action="/sil" class="sil-satir"
      onsubmit="return confirm('Bu kayıt silinsin mi? (Reddedilen &amp; Silinen arşivinden geri yüklenebilir)');"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
    <input type="hidden" name="don" value="<%= geri %>">
    <button type="submit" class="btn-mini del">🗑 Kaydı Sil</button>
</form>
<% } %>
<%- include('partials/footer') %>
