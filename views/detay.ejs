<%- include('partials/header') %>
<% const d = r.durum || 'Değerlendiriliyor';
   const detayGeri = '&geri=' + encodeURIComponent(geri);
   const benimRevizem = !silinen && denetmen && d == 'Düzeltme İsteniyor' && r.revize_atanan_id == denetmen.id;
   // Sabit puan kuralındaki öneri puanlama tablosuyla puanlanmaz; onaylanınca sahibine sabit puan yazılır
   const sabitOneri = tip == 'oneri' && kural.oneri_mod == 'sabit';
   // Onaylı öneri havuzu: 'beklemede' (uygulanamıyor, sonra bakılacak) / 'uygulanamadi' (kapatıldı); puan korunur
   const ud = tip == 'oneri' ? (r.uygulama_durumu || '') : '';
   const gozdenGeldi = ud == 'beklemede' && r.bekleme_gozden && r.bekleme_gozden <= bugun_iso; %>

<div class="list-head">
    <h1 class="page-title">
        <% if (tip == 'kaizen') { %><%- ik('wrench') %> Kaizen Detayı<% } else { %><%- ik('lightbulb') %> Öneri Detayı<% } %>
    </h1>
    <div class="list-actions">
        <a class="btn ghost" href="<%= geri %>">← <%= silinen ? 'Arşive Dön' : 'Listeye Dön' %></a>
        <% if (duzenleyebilir) { %>
        <a class="btn ghost" href="/<%= tip %>/duzenle?no=<%= encodeURIComponent(r.no) %><%= detayGeri %>"><%- ik('pencil') %> Düzenle</a>
        <% } %>
        <% if (!silinen && yetki('puanla') && d == 'Onaylandı' && !sabitOneri) { %>
        <a class="btn <%= r.puanlama ? 'ghost' : 'primary' %>" href="/degerlendir/puan?tip=<%= tip %>&no=<%= encodeURIComponent(r.no) %><%= detayGeri %>">★ <%= r.puanlama ? 'Puanı Düzenle' : 'Puanla' %></a>
        <% } %>
        <% if (donusturebilir) { %>
        <a class="btn primary" href="/kaizen/yeni?oneri=<%= encodeURIComponent(r.no) %>"><%- ik('wrench') %> Kaizene Dönüştür</a>
        <% } %>
    </div>
</div>

<% if (silinen) { %>
<div class="uyari-kutu"><%- ik('trash-2') %> Bu kayıt <strong><%= silinen.silme_zamani %></strong> tarihinde <strong><%= silinen.silen %></strong>
    tarafından silindi — yalnızca görüntüleniyor.
    <% if (yetki('kayit')) { %>
    <form method="post" action="/silinenler/geri" style="display:inline"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="id" value="<%= silinen.id %>">
        <button type="submit" class="btn-mini onay"><%- ik('undo-2') %> Geri Yükle</button>
    </form>
    <% } %>
</div>
<% } %>

<% if (benimRevizem) { %>
<div class="gorev-kutu">
    <strong><%- ik('pencil') %> Bu kaydın düzeltmesi size atandı.</strong>
    <p><%= r.revize_notu %></p>
    <small>İsteyen: <%= r.revize_isteyen || '—' %> · <%= r.revize_zamani || '' %></small>
    <div><a class="btn primary" href="/<%= tip %>/duzenle?no=<%= encodeURIComponent(r.no) %><%= detayGeri %>">Düzeltmeyi Yap</a></div>
</div>
<% } %>

<div class="detail-card">
    <div class="detail-top">
        <span class="mono badge"><%= r.no %></span>
        <% if (tip == 'kaizen') { %><span class="tip-badge kaizen">KAIZEN</span>
        <% } else { %><span class="tip-badge oneri">ÖNERİ</span><% } %>
        <% if (d == 'Onaylandı') { %><span class="durum-badge onay"><%= d %></span>
        <% } else if (d == 'Reddedildi') { %><span class="durum-badge red"><%= d %></span>
        <% } else if (d == 'Düzeltme İsteniyor') { %><span class="durum-badge revize"><%= d %></span>
        <% } else { %><span class="durum-badge bekle"><%= d %></span><% } %>
        <% if (ud == 'beklemede') { %><a class="durum-badge havuz" href="/havuz#beklemede" title="Onaylı – şu an uygulanamıyor; Öneri Havuzu'nda">
            <%- ikon.bekle %> Beklemede</a>
        <% } else if (ud == 'uygulanamadi') { %><a class="durum-badge kapali" href="/havuz#uygulanamadi" title="Onaylı – uygulanamadı olarak kapatıldı; Öneri Havuzu'nda">
            <%- ikon.kapali %> Uygulanamadı</a><% } %>
        <% if (sabitOneri) { %>
            <span class="puan-badge" title="Bu öneri puanlama tablosuyla değil, sabit puanla değerlendirilir">Sabit puan: <%= puanfmt(kural.oneri_sabit) %></span>
        <% } else if (r.puan !== null && r.puan !== '' && r.puan !== undefined) { %>
            <span class="puan-badge">Puan: <%= r.puan %></span>
        <% } %>
    </div>
    <% if (!silinen && (kazanc.sahibi > 0 || kazanc.lider > 0)) { %>
    <p class="kazanc-not"><%- ik('trophy') %> Puan listesine yazılan:
        <% if (tip == 'oneri') { %>öneri sahibine <strong>+<%= puanfmt(kazanc.sahibi) %></strong>
        <% } else { %>lidere <strong>+<%= puanfmt(kazanc.lider) %></strong><% if (kazanc.uye > 0) { %>, her üyeye <strong>+<%= puanfmt(kazanc.uye) %></strong><% } %><% } %>
        <small>(<%= sabitOneri ? 'sabit puan kuralı' : (tip == 'oneri' ? 'puanın %' + puanfmt(kural.oneri_oran) + ' payı' : 'lider %' + puanfmt(kural.kaizen_lider_oran) + ' · üye %' + puanfmt(kural.kaizen_uye_oran) + ' pay') %>)</small></p>
    <% } %>

    <% if (tip == 'oneri') { %>
    <h2 class="detail-konu"><%= r.konu %></h2>
    <div class="detail-grid">
        <div><span class="dl">Öneri Sahibi</span><span class="dv"><%= r.sahibi %></span></div>
        <div><span class="dl">Görevi</span><span class="dv"><%= r.gorevi %></span></div>
        <div><span class="dl">Bölüm</span><span class="dv"><%= r.bolum || '—' %></span></div>
        <div><span class="dl">Tarih</span><span class="dv"><%= trdate(r.tarih) %></span></div>
        <div><span class="dl">Kayıt</span><span class="dv"><%= r.kayit_zamani %></span></div>
    </div>

    <div class="detail-block"><h3>Detay Açıklama</h3><p><%= r.detay || '—' %></p></div>
    <div class="detail-block"><h3>Çözüm Önerisi</h3><p><%= r.cozum || '—' %></p></div>

    <div class="katki-grid">
        <div class="katki"><h4>1 · Kaliteye Katkısı</h4><p><%= r.kalite || '—' %></p></div>
        <div class="katki"><h4>2 · Verimliliğe Katkısı</h4><p><%= r.verimlilik || '—' %></p></div>
        <div class="katki"><h4>3 · İSG'ye Katkısı</h4><p><%= r.isg || '—' %></p></div>
        <div class="katki"><h4>4 · Maliyete Katkısı</h4><p><%= r.maliyet || '—' %></p></div>
    </div>
    <div class="detail-block"><h3>Ek Açıklama</h3><p><%= r.ek || '—' %></p></div>

    <% } else { %>
    <h2 class="detail-konu"><%= r.konu %></h2>
    <div class="detail-grid">
        <div><span class="dl">Başlangıç</span><span class="dv"><%= trdate(r.baslangic) %></span></div>
        <div><span class="dl">Bitiş</span><span class="dv"><%= trdate(r.bitis) || '—' %></span></div>
        <div><span class="dl">Yapıldığı Bölüm</span><span class="dv"><%= r.bolum || '—' %></span></div>
        <% const _gorevli = (ad, g) => ad + (g ? ` (${g})` : ''); %>
        <div><span class="dl">Kaizen Lideri</span><span class="dv"><%= r.lider ? _gorevli(r.lider, r.lider_gorevi) : (r.sorumlular || '—') %></span></div>
        <div><span class="dl">Üyeler</span><span class="dv"><%= (r.uyeler && r.uyeler.length)
            ? r.uyeler.map((u, i) => _gorevli(u, (r.uye_gorevleri || [])[i])).join(', ') : '—' %></span></div>
        <div><span class="dl">Kayıt</span><span class="dv"><%= r.kayit_zamani %></span></div>
    </div>

    <% if (r.kazanclar && r.kazanclar.length) { %>
    <div class="detail-block">
        <h3>Kazanç Başlıkları</h3>
        <div class="tags"><% for (const k of r.kazanclar) { %><span class="tag"><%= k %></span><% } %></div>
    </div>
    <% } %>

    <div class="prepost-grid">
        <div class="pp-col">
            <div class="pp-label before">ÖNCEKİ DURUM</div>
            <p><%= r.onceki || '—' %></p>
            <% if (r.onceki_maliyet != null) { %><p class="pp-maliyet"><%- ik('euro') %> Maliyet: <strong><%= parafmt(r.onceki_maliyet) %></strong></p><% } %>
            <% if (r.onceki_gorsel) { %>
            <a href="/kaizen/gorsel/<%= encodeURIComponent(r.onceki_gorsel) %>" target="_blank">
                <img loading="lazy" src="/kaizen/gorsel/<%= encodeURIComponent(r.onceki_gorsel) %>" alt="önce">
            </a>
            <% } %>
        </div>
        <div class="pp-col">
            <div class="pp-label after">SONRAKİ DURUM</div>
            <p><%= r.sonraki || '—' %></p>
            <% if (r.sonraki_maliyet != null) { %><p class="pp-maliyet"><%- ik('euro') %> Maliyet: <strong><%= parafmt(r.sonraki_maliyet) %></strong></p><% } %>
            <% if (r.sonraki_gorsel) { %>
            <a href="/kaizen/gorsel/<%= encodeURIComponent(r.sonraki_gorsel) %>" target="_blank">
                <img loading="lazy" src="/kaizen/gorsel/<%= encodeURIComponent(r.sonraki_gorsel) %>" alt="sonra">
            </a>
            <% } %>
        </div>
    </div>
    <% const mf = maliyetFarki(r); %>
    <% if (mf) { %><p class="maliyet-sonuc <%= mf.tur %>"><%- ik('euro') %> <%= mf.metin %> <small>(önceki − sonraki maliyet)</small></p>
    <% } else { %><p class="bos-not"><%- ik('euro') %> Maliyet hesabı girilmemiş (eski kayıt).</p><% } %>
    <% } %>

    <% if (r.puanlama) { const pz = r.puanlama;
       const temel = ('temel' in pz) ? pz.temel : ((pz.form || 0) + (pz.komite || 0)); %>
    <div class="detail-block">
        <h3>Puanlama Kırılımı — <%= pz.toplam %>/100</h3>
        <table class="puan-ozet-tablo">
            <tr><td>Temel Şartlar</td><td><%= temel %> / 10</td></tr>
            <tr><td>Etki Odağı<% if (pz.etki_odak) { %> <small>(<%= pz.etki_odak %>)</small><% } else if (pz.etki_label) { %> <small>(<%= pz.etki_label %>)</small><% } %></td><td><%= pz.etki || 0 %> / 40</td></tr>
            <tr><td>Maliyet ve Yatırım<% if (pz.maliyet_label) { %> <small>(<%= pz.maliyet_label %>)</small><% } %></td><td><%= pz.maliyet || 0 %> / 20</td></tr>
            <tr><td>Yaygınlaştırma<% if (pz.yaygin_label) { %> <small>(<%= pz.yaygin_label %>)</small><% } %></td><td><%= pz.yaygin || 0 %> / 15</td></tr>
            <tr><td>Efor ve Sahiplenme<% if (pz.efor_label) { %> <small>(<%= pz.efor_label %>)</small><% } %></td><td><%= pz.efor || 0 %> / 15</td></tr>
            <tr class="ozet-toplam"><td>TOPLAM</td><td><%= pz.toplam %> / 100</td></tr>
        </table>
    </div>
    <% } %>

    <% if (r.degerlendirme_notu) { %>
    <div class="detail-block"><h3>Değerlendirme Notu</h3><p><%= r.degerlendirme_notu %></p></div>
    <% } %>

    <% if (d == 'Reddedildi' && r.red_nedeni) { %>
    <div class="detail-block red-blok"><h3>✕ Red Nedeni</h3><p><%= r.red_nedeni %></p></div>
    <% } %>

    <% if (r.revize_notu) { %>
    <div class="detail-block"><h3><%- ik('pencil') %> Düzeltme Talebi</h3>
        <p><%= r.revize_notu %></p>
        <small class="bos-not">Atanan: <strong><%= r.revize_atanan_ad || '—' %></strong> · İsteyen: <%= r.revize_isteyen || '—' %>
            · <%= r.revize_zamani || '' %><% if (r.revize_tamamlandi) { %> · <%- ik('check') %> Düzeltildi: <%= r.revize_tamamlandi %><% } %></small>
    </div>
    <% } %>

    <% if (tip == 'oneri' && (r.gorev_atanan_ad || r.kaizen_no)) { %>
    <div class="detail-block"><h3><%- ik('pin') %> Uygulama Görevi</h3>
        <% if (r.gorev_atanan_ad) { %>
        <p><strong><%= r.gorev_atanan_ad %></strong><% if (r.gorev_termin) { %> · Termin: <%= trdate(r.gorev_termin) %><% } %></p>
        <% if (r.gorev_notu) { %><p><%= r.gorev_notu %></p><% } %>
        <small class="bos-not">Atayan: <%= r.gorev_atayan || '—' %> · <%= r.gorev_zamani || '' %></small>
        <% } %>
        <% if (r.kaizen_no) { %>
        <p><%- ik('check') %> Kaizene dönüştürüldü: <a href="/detay?tip=kaizen&no=<%= encodeURIComponent(r.kaizen_no) %>" class="mono"><%= r.kaizen_no %></a></p>
        <% } else if (r.gorev_atanan_ad) { %><p class="bos-not"><%- ik('hourglass') %> Henüz kaizene dönüştürülmedi.</p><% } %>
    </div>
    <% } %>

    <% if (ud == 'beklemede') { %>
    <div class="detail-block havuz-blok"><h3><%- ikon.bekle %> Öneri Havuzu — Beklemede</h3>
        <p><strong><%= r.bekleme_kategori || '—' %></strong></p>
        <% if (r.bekleme_nedeni) { %><p><%= r.bekleme_nedeni %></p><% } %>
        <p class="<%= gozdenGeldi ? 'gozden-geldi' : '' %>"><%- ikon.takvim %> Gözden geçirme: <strong><%= r.bekleme_gozden ? trdate(r.bekleme_gozden) : '—' %></strong><%= gozdenGeldi ? ' — tarihi geldi, yeniden değerlendirin' : '' %></p>
        <small class="bos-not">İşleyen: <%= r.uygulama_isleyen || '—' %> · <%= r.uygulama_zamani || '' %> · onay puanı korunur</small>
    </div>
    <% } else if (ud == 'uygulanamadi') { %>
    <div class="detail-block havuz-blok kapali"><h3><%- ikon.kapali %> Öneri Havuzu — Uygulanamadı</h3>
        <p><%= r.uygulanamadi_nedeni || '—' %></p>
        <small class="bos-not">Kapatan: <%= r.uygulama_isleyen || '—' %> · <%= r.uygulama_zamani || '' %> · onay puanı korunur</small>
    </div>
    <% } %>

    <% if (tip == 'kaizen' && r.kaynak_oneri_no) { %>
    <div class="detail-block"><h3><%- ik('lightbulb') %> Kaynak Öneri</h3>
        <p>Bu kaizen <a href="/detay?tip=oneri&no=<%= encodeURIComponent(r.kaynak_oneri_no) %>" class="mono"><%= r.kaynak_oneri_no %></a> önerisinden dönüştürüldü.</p>
    </div>
    <% } %>

    <% if (r.guncelleme_zamani) { %>
    <div class="kc-foot">Son güncelleme: <%= r.guncelleme_zamani %></div>
    <% } %>
</div>

<% if (!silinen && yetki('degerlendir')) { %>
<h2 class="bolum-baslik" id="degerlendir"><%- ik('scale') %> Değerlendirme</h2>
<% if (!denetmenler.length) { %>
<p class="uyari-kutu">Düzeltme veya görev atamak için önce <a href="/yonetici#denetmenler">Yönetim › Denetmenler</a>'den denetmen hesabı açın.</p>
<% } %>
<div class="degerlendir-grid">
    <% if (d != 'Onaylandı') { %>
    <form method="post" action="/durum" class="panel degerlendir-kart onay-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Onaylandı"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3>✓ Onayla</h3>
        <% if (tip == 'oneri') { %>
        <p class="bos-not">İsterseniz uygulayıp kaizene dönüştürecek kişiyi şimdi atayın; atarsanız termin ve açıklama zorunludur:</p>
        <select name="gorev_denetmen" data-gorev-sec><option value="">— görev atama (isteğe bağlı) —</option><%- include('partials/denetmen_secenekleri', { denetmenler, secili: null }) %></select>
        <input type="date" name="gorev_termin" min="<%= bugun_iso %>" data-gorev-alan
               title="Termin — görev atanırsa zorunlu" placeholder="Termin — görev atanırsa zorunlu">
        <textarea name="gorev_notu" rows="2" data-gorev-alan placeholder="Görev açıklaması (ne yapılacak) — görev atanırsa zorunlu"></textarea>
        <% if (sabitOneri) { %><p class="bos-not">Onaylanınca öneri sahibine <strong><%= puanfmt(kural.oneri_sabit) %> puan</strong> yazılır (puanlama tablosu kullanılmaz).</p><% } %>
        <% } else { %>
        <p class="bos-not">Onaylandıktan sonra puanlanabilir.</p>
        <% } %>
        <button type="submit" class="btn primary">✓ Onayla</button>
    </form>

    <% if (d != 'Reddedildi') { %>
    <form method="post" action="/durum" class="panel degerlendir-kart red-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Reddedildi"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3>✕ Reddet</h3>
        <textarea name="red_nedeni" rows="3" required placeholder="Red nedeni — zorunlu"></textarea>
        <button type="submit" class="btn-mini reddet">✕ Reddet</button>
    </form>
    <% } else { %>
    <form method="post" action="/durum" class="panel degerlendir-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Değerlendiriliyor"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3><%- ik('undo-2') %> Değerlendirmeye Geri Al</h3>
        <p class="bos-not">Reddedilen kayıt yeniden "Değerlendiriliyor" durumuna alınır.</p>
        <button type="submit" class="btn-mini edit"><%- ik('undo-2') %> Geri Al</button>
    </form>
    <% } %>

    <% if (denetmenler.length) { %>
    <form method="post" action="/durum" class="panel degerlendir-kart revize-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
        <input type="hidden" name="durum" value="Düzeltme İsteniyor"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3><%- ik('pencil') %> Düzeltme İste<%= d == 'Düzeltme İsteniyor' ? ' (yeniden ata)' : '' %></h3>
        <select name="revize_denetmen" required><option value="">— düzeltmeyi yapacak denetmen —</option><%- include('partials/denetmen_secenekleri', { denetmenler, secili: r.revize_atanan_id }) %></select>
        <textarea name="revize_notu" rows="3" required placeholder="Neyin düzeltilmesi gerekiyor — zorunlu"><%= d == 'Düzeltme İsteniyor' ? (r.revize_notu || '') : '' %></textarea>
        <button type="submit" class="btn-mini revize"><%- ik('pencil') %> Düzeltme İste</button>
    </form>
    <% } %>
    <% } else if (tip == 'oneri' && !r.kaizen_no) { %>
    <% if (!ud && denetmenler.length) { %>
    <form method="post" action="/gorev" class="panel degerlendir-kart onay-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="no" value="<%= r.no %>"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <h3><%- ik('pin') %> <%= r.gorev_atanan_id ? 'Görevi Değiştir' : 'Uygulama Görevi Ata' %></h3>
        <p class="bos-not">Atanan kişi öneriyi uygular ve kaizene dönüştürür.</p>
        <select name="gorev_denetmen" required><option value="">— denetmen seçin —</option><%- include('partials/denetmen_secenekleri', { denetmenler, secili: r.gorev_atanan_id }) %></select>
        <%# Eski görevin termini geçmişte kaldıysa aynı tarih seçili kalabilsin diye min ona çekilir (sunucu: değişmeyen termin kabul) %>
        <input type="date" name="gorev_termin" value="<%= r.gorev_termin || '' %>" required
               min="<%= r.gorev_termin && r.gorev_termin < bugun_iso ? r.gorev_termin : bugun_iso %>"
               title="Termin — zorunlu" placeholder="Termin — zorunlu">
        <textarea name="gorev_notu" rows="2" required placeholder="Görev açıklaması (ne yapılacak) — zorunlu"><%= r.gorev_notu || '' %></textarea>
        <button type="submit" class="btn primary"><%- ik('pin') %> Kaydet</button>
        <% if (r.gorev_atanan_id) { %>
        <button type="submit" name="kaldir" value="1" class="btn-mini del" formnovalidate>Görevi Kaldır</button>
        <% } %>
    </form>
    <% } %>

    <% if (ud != 'uygulanamadi') { %>
    <form method="post" action="/oneri/havuz" class="panel degerlendir-kart havuz-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="no" value="<%= r.no %>"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <input type="hidden" name="islem" value="beklemeye_al">
        <h3><%- ikon.bekle %> <%= ud == 'beklemede' ? 'Bekleme Bilgisini Güncelle' : 'Beklemeye Al (Öneri Havuzu)' %></h3>
        <p class="bos-not">Şu an uygulanamayan öneri için. Onay puanı korunur<%= r.gorev_atanan_ad ? '; ' + r.gorev_atanan_ad + ' kişisinin uygulama görevi kaldırılır' : '' %>.</p>
        <select name="bekleme_kategori" required>
            <option value="">— neden bekliyor? —</option>
            <% for (const k of bekleme_kategorileri) { %><option<%= ud == 'beklemede' && r.bekleme_kategori == k ? ' selected' : '' %>><%= k %></option><% } %>
        </select>
        <textarea name="bekleme_nedeni" rows="2" required placeholder="Açıklama (ne bekleniyor?) — zorunlu"><%= ud == 'beklemede' ? (r.bekleme_nedeni || '') : '' %></textarea>
        <%# Mevcut gözden geçirme tarihi geçmişte kaldıysa aynı tarih seçili kalabilsin diye min ona çekilir (sunucu: değişmeyen tarih kabul) %>
        <% const gEski = ud == 'beklemede' ? (r.bekleme_gozden || '') : ''; %>
        <input type="date" name="bekleme_gozden" value="<%= gEski %>" required
               min="<%= gEski && gEski < bugun_iso ? gEski : bugun_iso %>"
               title="Gözden geçirme tarihi — zorunlu" placeholder="Gözden geçirme tarihi — zorunlu">
        <button type="submit" class="btn primary"><%= ud == 'beklemede' ? 'Güncelle' : 'Beklemeye Al' %></button>
    </form>
    <% } %>

    <% if (ud == 'beklemede') { %>
    <form method="post" action="/oneri/havuz" class="panel degerlendir-kart onay-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="no" value="<%= r.no %>"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <input type="hidden" name="islem" value="havuzdan_cikar">
        <h3><%- ikon.devam %> Havuzdan Çıkar</h3>
        <p class="bos-not">Engel kalktıysa öneri normale döner; uygulama görevi atanabilir ve kaizene dönüştürülebilir.</p>
        <button type="submit" class="btn-mini onay">Havuzdan Çıkar</button>
    </form>
    <% } %>

    <% if (ud != 'uygulanamadi') { %>
    <form method="post" action="/oneri/havuz" class="panel degerlendir-kart red-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="no" value="<%= r.no %>"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <input type="hidden" name="islem" value="uygulanamadi">
        <h3><%- ikon.kapali %> Uygulanamadı Olarak Kapat</h3>
        <p class="bos-not">Öneri onaylı kalır ve puanı korunur, ama uygulanmayacağı kayda geçer.</p>
        <textarea name="uygulanamadi_nedeni" rows="2" required placeholder="Neden uygulanamadı — zorunlu"></textarea>
        <button type="submit" class="btn-mini reddet">Uygulanamadı Olarak Kapat</button>
    </form>
    <% } else { %>
    <form method="post" action="/oneri/havuz" class="panel degerlendir-kart"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
        <input type="hidden" name="no" value="<%= r.no %>"><input type="hidden" name="don" value="<%= bu_sayfa %>">
        <input type="hidden" name="islem" value="yeniden_ac">
        <h3><%- ik('undo-2') %> Yeniden Aç</h3>
        <p class="bos-not">"Uygulanamadı" kapanışı geri alınır; öneri yeniden uygulanabilir hâle gelir.</p>
        <button type="submit" class="btn-mini edit"><%- ik('undo-2') %> Yeniden Aç</button>
    </form>
    <% } %>
    <% } %>
</div>
<script>
// Onay kartında görevi yapacak kişi seçilince termin ve açıklama zorunlu olur (sunucu da denetler).
// Tarih kutusunun görünen kopyası (takvim) de güncellenir.
document.querySelectorAll('[data-gorev-sec]').forEach(function (sec) {
    function guncelle() {
        sec.form.querySelectorAll('[data-gorev-alan]').forEach(function (el) {
            el.required = !!sec.value;
            if (el._flatpickr && el._flatpickr.altInput) el._flatpickr.altInput.required = !!sec.value;
        });
    }
    sec.addEventListener('change', guncelle);
    guncelle();
});
</script>
<% } %>

<% if (!silinen && yetki('kayit')) { %>
<form method="post" action="/sil" class="sil-satir"
      onsubmit="return confirm('Bu kayıt silinsin mi? (Reddedilen &amp; Silinen arşivinden geri yüklenebilir)');"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <input type="hidden" name="tip" value="<%= tip %>"><input type="hidden" name="no" value="<%= r.no %>">
    <input type="hidden" name="don" value="<%= geri %>">
    <button type="submit" class="btn-mini del"><%- ik('trash-2') %> Kaydı Sil</button>
</form>
<% } %>
<%- include('partials/footer') %>
