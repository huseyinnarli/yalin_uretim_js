<%- include('partials/header') %>
<h1 class="page-title">Yalın Üretim Uygulamaları</h1>
<p class="subtitle">Bir uygulama seçin.</p>

<div class="hub-boxes">
    <a class="hub-box" href="/puan-durumu">
        <div class="hub-box-icon">🏆</div>
        <h2>Puan Listesi</h2>
        <p>Personel puan sıralaması — öneri, kaizen ve 5S puanları.</p>
        <span class="hub-go">Sıralamaya git →</span>
    </a>

    <div class="hub-box">
        <div class="hub-box-icon">💡🔧</div>
        <h2>Öneri &amp; Kaizen</h2>
        <p>Önerinizi veya yaptığınız kaizeni formla iletin.</p>
        <div class="hub-linkler">
            <a class="btn primary" href="/oneri/yeni">+ Öneri Yaz</a>
            <a class="btn primary" href="/kaizen/yeni">+ Kaizen Yaz</a>
        </div>
        <% if (girisli) { %>
        <a class="hub-go" href="/liste">Listeye git →</a>
        <% } else { %>
        <span class="hub-not">Kayıtları görmek için <a href="/yonetici/giris?next=%2Fliste">giriş yapın</a>.</span>
        <% } %>
    </div>

    <a class="hub-box" href="/5s">
        <div class="hub-box-icon">🧹</div>
        <h2>5S</h2>
        <p>Bölüm 5S denetim sonuçları, sıralama ve aksiyonlar.</p>
        <span class="hub-go">Bölümlere git →</span>
    </a>
</div>
<%- include('partials/footer') %>
