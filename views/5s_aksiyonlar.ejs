<%- include('partials/header') %>

<div class="list-head">
    <h1 class="page-title"><%- ik('flag') %> <%= kendi ? 'Benim Aksiyonlarım' : '5S Aksiyonlar' %></h1>
    <div class="list-actions">
        <a class="btn ghost" href="/5s">← 5S</a>
        <% if (yetki('bes_aksiyon')) { %>
        <a class="btn ghost" href="/5s/aksiyonlar/excel"><%- ik('download') %> Aksiyon Excel</a>
        <a class="btn ghost" href="/5s/aksiyonlar/fotolar.zip"><%- ik('download') %> Fotoğraflar (ZIP)</a>
        <% } %>
    </div>
</div>

<% if (denetmen_mi) { %>
<nav class="sekme-cubugu" aria-label="Aksiyon görünümü">
    <a href="/5s/aksiyonlar" class="<%= kendi ? 'aktif' : '' %>"><%- ik('user') %> Benim Aksiyonlarım</a>
    <a href="/5s/aksiyonlar?gorunum=tumu" class="<%= kendi ? '' : 'aktif' %>"><%- ik('factory') %> Tüm Aksiyonlar</a>
</nav>
<% } %>
<% if (kendi) { %>
<p class="subtitle">Size atanan aksiyonlar — geçmiş ve güncel denetimlerden, açık ve kapattığınız: ekip lideri olduğunuz
    bölümlerin aksiyonları ve sorumlusu olduğunuz aksiyonlar.</p>
<% } else if (denetmen_mi) { %>
<p class="subtitle">Bütün bölümlerin aksiyonları (görüntüleme). Kapatma düğmesi yalnız kapatabileceğiniz aksiyonlarda görünür.</p>
<% } %>
<% if (bolum_secenek.length > 1 && !kendi) { %>
<form method="get" action="/5s/aksiyonlar" class="filter-bar aksiyon-suzgec">
    <% if (denetmen_mi && !kendi) { %><input type="hidden" name="gorunum" value="tumu"><% } %>
    <div class="filter-group">
        <label for="aksiyon-bolum">Bölüm</label>
        <select id="aksiyon-bolum" name="bolum" onchange="this.form.submit()">
            <option value="">Tüm bölümler</option>
            <% for (const b of bolum_secenek) { %><option value="<%= b.id %>"<%= b.id === bolum_id ? ' selected' : '' %>><%= b.ad %></option><% } %>
        </select>
    </div>
    <% if (bolum_id) { %><a class="btn ghost" href="/5s/aksiyonlar<%= denetmen_mi && !kendi ? '?gorunum=tumu' : '' %>">Temizle</a><% } %>
</form>
<% } %>

<% if (acik_gruplar.length || kapali_gruplar.length) { %>

<h2 class="bolum-baslik aksiyon-bolum-baslik acik">● Açık Aksiyonlar
    <span class="rozet-acik"><%= toplam_acik %></span></h2>
<% if (acik_gruplar.length) { %>
<div class="aksiyon-gruplar">
    <% acik_gruplar.forEach(function (g, gi) { %>
    <%# En yeni turun açık aksiyonları açık gelir; başlıkta bölüm adları (açmadan hangi bölümde ne kadar açık var görünsün) %>
    <details class="tur-blok aksiyon-tur"<%= gi === 0 ? ' open' : '' %>>
        <summary class="tur-summary">
            <span class="tur-ok">▸</span>
            <span class="ag-durum acik-var"></span>
            <span class="tur-ad"><%= g.tur_adi %></span>
            <span class="tur-bolum-sayisi"><%= g.bolumler.length %> bölüm · <%= g.toplam %> aksiyon</span>
            <span class="tur-bolum-cipler"><% for (const bl of g.bolumler) { %><span class="bolum-cip acik"><%= bl.ad %> <b><%= bl.aksiyonlar.length %></b></span><% } %></span>
        </summary>
        <div class="aksiyon-grup-icerik">
            <% for (const bl of g.bolumler) { %>
            <div class="aksiyon-bolum">
                <h4 class="aksiyon-bolum-ad"><%- ik('factory') %> <%= bl.ad %> <span class="tur-bolum-sayisi"><%= bl.aksiyonlar.length %></span></h4>
                <% for (const a of bl.aksiyonlar) { %><%- include('partials/aksiyon_kart', { a: a }) %><% } %>
            </div>
            <% } %>
        </div>
    </details>
    <% }); %>
</div>
<% } else { %>
<p class="bos-not"><%- ik('party-popper') %> <%= kendi ? 'Açık aksiyonunuz yok.' : 'Açık aksiyon yok — tüm aksiyonlar kapatılmış.' %></p>
<% } %>

<h2 class="bolum-baslik aksiyon-bolum-baslik kapali"><%- ik('check') %> Kapalı Aksiyonlar
    <span class="rozet-kapali"><%= toplam_kapali %></span></h2>
<% if (kapali_gruplar.length) { %>
<div class="aksiyon-gruplar">
    <% for (const g of kapali_gruplar) { %>
    <details class="tur-blok aksiyon-tur">
        <summary class="tur-summary">
            <span class="tur-ok">▸</span>
            <span class="ag-durum temiz"></span>
            <span class="tur-ad"><%= g.tur_adi %></span>
            <span class="tur-bolum-sayisi"><%= g.bolumler.length %> bölüm · <%= g.toplam %> aksiyon</span>
            <span class="tur-bolum-cipler"><% for (const bl of g.bolumler) { %><span class="bolum-cip"><%= bl.ad %> <b><%= bl.aksiyonlar.length %></b></span><% } %></span>
        </summary>
        <div class="aksiyon-grup-icerik">
            <% for (const bl of g.bolumler) { %>
            <div class="aksiyon-bolum">
                <h4 class="aksiyon-bolum-ad"><%- ik('factory') %> <%= bl.ad %> <span class="tur-bolum-sayisi"><%= bl.aksiyonlar.length %></span></h4>
                <% for (const a of bl.aksiyonlar) { %><%- include('partials/aksiyon_kart', { a: a }) %><% } %>
            </div>
            <% } %>
        </div>
    </details>
    <% } %>
</div>
<% } else { %>
<p class="bos-not">Henüz kapatılmış aksiyon yok.</p>
<% } %>

<% } else { %>
<% if (kendi) { %>
<div class="empty">Size atanmış aksiyon yok.</div>
<% } else { %>
<div class="empty">Henüz atanmış aksiyon yok. Denetim formunda her madde için <strong><%- ik('flag') %> Aksiyon Ata</strong> ile aksiyon oluşturabilirsiniz.</div>
<% } %>
<% } %>

<script>
(function () {
    if (location.hash) {
        var el = document.querySelector(location.hash);
        if (el) {
            var grp = el.closest('details.aksiyon-tur');
            if (grp) grp.open = true;
            el.scrollIntoView({ block: 'center' });
        }
    }
})();
</script>
<%- include('partials/footer') %>
