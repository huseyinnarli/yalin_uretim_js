<%- include('partials/header') %>

<div class="list-head">
    <h1 class="page-title">🗑 Silinen Kayıtlar</h1>
    <div class="list-actions">
        <a class="btn ghost" href="/liste">← Öneri &amp; Kaizen</a>
    </div>
</div>

<p class="subtitle">Silinen öneri ve kaizenler burada saklanır. <strong>Geri Yükle</strong> ile listeye geri
    alabilir, <strong>Kalıcı Sil</strong> ile tamamen kaldırabilirsiniz (kalıcı silme geri alınamaz).</p>

<% if (kayitlar.length) { %>
<div class="table-wrap">
<table class="data-table">
    <thead>
        <tr><th>Tür</th><th>No</th><th>Tarih</th><th>Konu</th><th>Kişi</th><th>Durum</th><th>Silen</th><th>Silme Zamanı</th><th>İşlem</th></tr>
    </thead>
    <tbody>
        <% for (const k of kayitlar) { %>
        <tr>
            <td data-label="Tür">
                <% if (k.tip == 'kaizen') { %><span class="tip-badge kaizen">KAIZEN</span>
                <% } else { %><span class="tip-badge oneri">ÖNERİ</span><% } %>
            </td>
            <td class="mono nowrap" data-label="No"><%= k.no %></td>
            <td class="nowrap" data-label="Tarih"><%= trdate(k.tarih) %></td>
            <td data-label="Konu"><%= k.konu || '(başlıksız)' %></td>
            <td data-label="Kişi"><%= k.kisi %></td>
            <td class="nowrap" data-label="Durum">
                <% const d = k.durum || 'Değerlendiriliyor'; %>
                <% if (d == 'Onaylandı') { %><span class="durum-badge onay"><%= d %></span>
                <% } else if (d == 'Reddedildi') { %><span class="durum-badge red"><%= d %></span>
                <% } else if (d == 'Düzeltme İsteniyor') { %><span class="durum-badge revize"><%= d %></span>
                <% } else { %><span class="durum-badge bekle"><%= d %></span><% } %>
            </td>
            <td data-label="Silen"><%= k.silen %></td>
            <td class="nowrap" data-label="Silme Zamanı"><%= k.silme_zamani %></td>
            <td class="nowrap islem-hucre" data-label="İşlem">
                <form method="post" action="/silinenler/geri" style="display:inline">
                    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                    <input type="hidden" name="id" value="<%= k.id %>">
                    <button type="submit" class="btn-mini onay" title="Listeye geri al">↩ Geri Yükle</button>
                </form>
                <form method="post" action="/silinenler/sil" style="display:inline"
                      onsubmit="return confirm('“<%= k.no %>” KALICI olarak silinsin mi? Bu işlem geri alınamaz.');">
                    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                    <input type="hidden" name="id" value="<%= k.id %>">
                    <button type="submit" class="btn-mini del">Kalıcı Sil</button>
                </form>
            </td>
        </tr>
        <% } %>
    </tbody>
</table>
</div>
<% } else { %>
<div class="empty">Silinmiş kayıt yok.</div>
<% } %>
<%- include('partials/footer') %>
