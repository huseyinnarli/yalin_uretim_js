<%- include('partials/header') %>

<div class="list-head">
    <h1 class="page-title">🧹 <%= b.ad %></h1>
    <div class="list-actions">
        <a class="btn ghost" href="/5s">← Bölümler</a>
    </div>
</div>

<div class="iki-kolon">
    <!-- Ekip -->
    <div class="panel">
        <h3>Ekip</h3>
        <div class="kisi-satir lider">
            <span>👤 <strong><%= b.sorumlu || '—' %></strong> <span class="rol">ekip lideri</span></span>
        </div>
        <% if (admin) { %>
        <form method="post" action="/5s/bolum/<%= b.id %>/lider" class="satir-form lider-form"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
            <input type="text" name="lider1" value="<%= lider1 %>" placeholder="1. Ekip Lideri (Ad Soyad)">
            <input type="text" name="lider2" value="<%= lider2 %>" placeholder="2. Ekip Lideri (Ad Soyad)"
                   class="lider2-input"<%= !lider2 ? ' hidden' : '' %>>
            <button type="button" class="btn-mini ekle-lider2"<%= lider2 ? ' hidden' : '' %>>+ 2. Ekip Lideri</button>
            <button type="submit" class="btn-mini edit">Kaydet</button>
        </form>
        <% } %>
        <% for (const k of b.kisiler) { %>
        <div class="kisi-satir">
            <span><%= k %></span>
            <% if (admin) { %>
            <form method="post" action="/5s/bolum/<%= b.id %>/kisi/sil" style="display:inline"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                <input type="hidden" name="ad" value="<%= k %>">
                <button type="submit" class="btn-mini del" title="Sil">×</button>
            </form>
            <% } %>
        </div>
        <% } %>
        <% if (!b.kisiler.length) { %><p class="bos-not">Henüz üye eklenmemiş.</p><% } %>

        <% if (admin) { %>
        <form method="post" action="/5s/bolum/<%= b.id %>/kisi/ekle" class="satir-form mt"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
            <input type="text" name="ad" placeholder="Kişi ekle (Ad Soyad)" required>
            <button type="submit" class="btn primary">+ Ekle</button>
        </form>
        <% } %>
    </div>

    <!-- Denetim geçmişi -->
    <div class="panel">
        <h3>Denetim Geçmişi</h3>
        <% if (denetimler.length) { %>
        <table class="data-table mini-tablo">
            <thead><tr><th>Tarih</th><th>Skor</th><th></th></tr></thead>
            <tbody>
                <% for (const d of denetimler) { %>
                <tr>
                    <td data-label="Tarih"><%= trdate(d.tarih) %></td>
                    <td data-label="Skor">
                        <% if (d.puan !== null) { %>
                            <span class="skor-rozet <%= d.puan >= 80 ? 'iyi' : (d.puan >= 60 ? 'orta' : 'dusuk') %>"><%= d.puan %>/100</span>
                        <% } else { %>
                            <span class="skor-rozet bekle">Yapılacak</span>
                        <% } %>
                    </td>
                    <td data-label="">
                        <% if (d.puan !== null) { %>
                        <a class="btn-mini eval" href="/5s/denetim/<%= d.id %>">Formu Gör</a>
                        <% } else if (admin) { %>
                        <a class="btn-mini edit" href="/5s/bolum/<%= b.id %>/denetim">Doldur</a>
                        <% } %>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
        <% } else { %>
        <p class="bos-not">Bu bölüm için henüz denetim yapılmamış.</p>
        <% } %>
    </div>
</div>

<script>
document.querySelectorAll('.ekle-lider2').forEach(function (btn) {
    btn.addEventListener('click', function () {
        var inp = btn.parentElement.querySelector('.lider2-input');
        if (inp) { inp.hidden = false; inp.focus(); }
        btn.hidden = true;
    });
});
</script>
<%- include('partials/footer') %>
