<%- include('partials/header') %>

<div class="list-head">
<% const rv = (typeof revize !== 'undefined' && revize) ? revize : null; %>
    <h1 class="page-title"><%= rv ? '✏ Denetim Revize' : '📋 5S Denetim' %> — <%= b.ad %></h1>
    <div class="list-actions">
        <a class="btn ghost" href="<%= rv ? '/5s/denetim/' + rv.d.id : '/5s#plan' %>">← Geri</a>
        <a class="btn ghost" href="/5s/bolum/<%= b.id %>">🏭 Bölüm</a>
    </div>
</div>

<% if (rv) { %>
<div class="gorev-kutu"><strong>✏ Revize modu.</strong> Bu denetim <strong><%= rv.d.denetmen || '—' %></strong> tarafından
    <strong><%= trdate(rv.d.denetim_tarihi || rv.d.tarih) %></strong> tarihinde yapıldı (skor <%= rv.d.puan %>/100).
    Kaydettiğinizde puan yeniden hesaplanır; denetmen ve tarih değişmez, revize eden olarak adınız kaydedilir.</div>
<% } %>
<p class="subtitle">
    <% if (bekleyen && !rv) { %>Denetleme tarihi: <strong><%= trdate(bekleyen.tarih) %></strong>.<% } %>
    Her soruda <strong>bulgu sayısını</strong> (veya Evet/Hayır) seçin — puan, form kuralına göre
    <strong>otomatik hesaplanır</strong>. Bulguları madde madde açıklama kutusuna yazın.
    Denetim, alanın takım lideriyle birlikte yapılmalıdır.
</p>

<form method="post" action="<%= rv ? '/5s/denetim/' + rv.d.id + '/revize' : '/5s/bolum/' + b.id + '/denetim' %>" enctype="multipart/form-data" id="denetimForm"><input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <div class="row">
        <div class="field small" style="max-width:240px">
            <label>Ekip Lideri</label>
            <input type="text" value="<%= b.sorumlu || '—' %>" readonly tabindex="-1" class="otomatik-ad">
        </div>
        <% if (bekleyen && bekleyen.misafir_denetmen) { %>
        <div class="field small" style="max-width:240px">
            <label>Misafir Denetmen</label>
            <input type="text" value="🎫 <%= bekleyen.misafir_denetmen %>" readonly tabindex="-1" class="otomatik-ad">
        </div>
        <% } %>
        <% if (!bekleyen && !rv) { %>
        <div class="field small" style="max-width:200px">
            <label>Denetim Tarihi</label>
            <input type="date" name="tarih" value="<%= bugun %>">
        </div>
        <% } %>
        <div class="field" style="max-width:280px">
            <label>Denetmen <% if (bekleyen && bekleyen.planlanan_denetmen) { %><small>(planlanan: <%= bekleyen.planlanan_denetmen %>)</small><% } %></label>
            <% if (rv) { %>
            <input type="text" value="<%= rv.d.denetmen || '—' %>" readonly tabindex="-1" class="otomatik-ad">
            <% } else if (denetmen_adi) { %>
            <input type="text" value="<%= denetmen_adi %>" readonly tabindex="-1" class="otomatik-ad"
                   title="Denetmen adı oturumunuzdan otomatik alınır">
            <% } else { %>
            <input type="text" name="denetmen"
                   value="<%= bekleyen ? (bekleyen.denetmen || bekleyen.planlanan_denetmen) : '' %>"
                   placeholder="Denetimi yapan kişi">
            <% } %>
        </div>
    </div>

    <% const mevcut = (bekleyen && bekleyen.fotolar) || {};
       const aciklamalar = (bekleyen && bekleyen.aciklamalar) || {}; %>
    <% for (const s of bess) { %>
    <fieldset class="puan-blok">
        <legend><%= s.ad %> <span class="blok-max">(<%= s.puan %> puan)</span></legend>
        <% if (s.aciklama) { %><p class="blok-alt-not"><%= s.aciklama %></p><% } %>
        <% for (const kr of s.kriterler) { const varolan = mevcut[kr.k] || []; const ku = kr.kural; %>
        <div class="bess-kriter">
            <div class="kriter-satir">
                <% if (ku.tip === 'evet_hayir') { %>
                <% const secB = rv ? (rv.bulgular[kr.k] || 0) : 0; %>
                <select class="bess-puan bess-bulgu" name="bulgu_<%= kr.k %>" title="Evet / Hayır"
                        data-tip="e" data-max="<%= kr.puan %>">
                    <option value="0" <%= secB > 0 ? '' : 'selected' %>>Evet</option>
                    <option value="1" <%= secB > 0 ? 'selected' : '' %>>Hayır</option>
                </select>
                <% } else { %>
                <select class="bess-puan bess-bulgu" name="bulgu_<%= kr.k %>" title="Bulgu sayısı"
                        data-tip="b" data-max="<%= kr.puan %>" data-dusus="<%= ku.dusus %>" data-sifir="<%= ku.sifir %>">
                    <% const secB = rv ? Math.min(rv.bulgular[kr.k] || 0, ku.sifir) : 0;
                       for (let v = 0; v <= ku.sifir; v++) { %>
                    <option value="<%= v %>" <%= v === secB ? 'selected' : '' %>><%= v === ku.sifir ? v + '+' : v %> bulgu</option>
                    <% } %>
                </select>
                <% } %>
                <span class="ps-acik"><%= kr.m %> <small class="kural-not">— <%= kural_metni(kr) %></small></span>
                <span class="ps-puan"><b class="kriter-puan"><%= kr.puan %></b> / <%= kr.puan %></span>
            </div>
            <div class="kriter-aciklama-satir">
                <textarea class="kriter-aciklama" name="aciklama_<%= kr.k %>" rows="2"
                          placeholder="Açıklama / bulgu..."><%= aciklamalar[kr.k] || '' %></textarea>
                <button type="button" class="btn-mini aksiyon-ata-btn" data-k="<%= kr.k %>">⚑ Aksiyon Ata</button>
            </div>
            <% if (rv && rv.acik_aksiyon[kr.k]) { %>
            <p class="bos-not">⚑ Bu soruda <%= rv.acik_aksiyon[kr.k] %> açık aksiyon var (kriter başına en fazla 2 açık aksiyon).</p>
            <% } %>
            <% for (const slot of [1, 2]) { %>
            <div class="aksiyon-alan" id="aksiyon-<%= kr.k %>-<%= slot %>" hidden>
                <span class="aksiyon-slot-no"><%= slot %>.</span>
                <div class="aksiyon-grid">
                    <input type="text" name="aksiyon_<%= kr.k %>_<%= slot %>" placeholder="Aksiyon (yapılacak iş)">
                    <input type="text" name="aksiyon_sorumlu_<%= kr.k %>_<%= slot %>"
                           value="<%= b.sorumlu %>" placeholder="Sorumlu kişi (varsayılan: ekip lideri)">
                    <input type="date" name="aksiyon_termin_<%= kr.k %>_<%= slot %>" min="<%= denetim_gunu %>"
                           title="Termin (denetim tarihinden sonra olmalı)">
                </div>
                <button type="button" class="btn-mini del aksiyon-kaldir" data-k="<%= kr.k %>" data-slot="<%= slot %>"
                        title="Bu aksiyonu kaldır">✕</button>
            </div>
            <% } %>
            <div class="kriter-foto">
                <span class="foto-label">📷 Fotoğraf (en fazla 3)</span>
                <div class="foto-butonlar">
                    <% for (const fn of varolan) { %>
                    <% if (rv) { %>
                    <label class="foto-sil" title="İşaretlerseniz kayıtta silinir">
                        <img loading="lazy" class="foto-mini" src="/5s/gorsel/<%= encodeURIComponent(fn) %>" alt="foto">
                        <span><input type="checkbox" name="foto_sil" value="<%= fn %>"> sil</span>
                    </label>
                    <% } else { %>
                    <img loading="lazy" class="foto-mini" src="/5s/gorsel/<%= encodeURIComponent(fn) %>" alt="foto">
                    <% } %>
                    <% } %>
                    <% for (let i = 0; i < 3 - varolan.length; i++) { %>
                    <input type="file" name="foto_<%= kr.k %>" accept="image/*" class="foto-input">
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>
    </fieldset>
    <% } %>

    <fieldset class="puan-blok sonuc-blok">
        <div class="field">
            <label>Denetim Notu / Bulgular</label>
            <textarea name="not" rows="3" placeholder="Tespitler, açılması gereken aksiyonlar..."><%= rv ? (rv.d.not || '') : '' %></textarea>
        </div>
    </fieldset>

    <div class="toplam-bar">
        <span>5S SKORU</span>
        <span class="toplam-deger"><strong id="skor">100</strong> / 100</span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn primary"><%= rv ? 'Revizeyi Kaydet' : 'Denetimi Kaydet' %></button>
        <a class="btn ghost" href="<%= rv ? '/5s/denetim/' + rv.d.id : '/5s/bolum/' + b.id %>">İptal</a>
    </div>
</form>

<script>
(function () {
    var form = document.getElementById('denetimForm');
    var out = document.getElementById('skor');
    // Kural tabanlı puan: evet_hayir → bulgu>0 ise 0; bulgu → sifir eşiğinde 0, yoksa max - dusus×bulgu
    function kriterPuan(el) {
        var bulgu = parseInt(el.value, 10) || 0;
        var max = parseInt(el.dataset.max, 10) || 0;
        if (el.dataset.tip === 'e') return bulgu > 0 ? 0 : max;
        var sifir = parseInt(el.dataset.sifir, 10) || 1;
        var dusus = parseInt(el.dataset.dusus, 10) || 0;
        if (bulgu >= sifir) return 0;
        return Math.max(0, max - dusus * bulgu);
    }
    function hesapla() {
        var skor = 0;
        form.querySelectorAll('.bess-bulgu').forEach(function (el) {
            var p = kriterPuan(el);
            skor += p;
            var goster = el.closest('.kriter-satir').querySelector('.kriter-puan');
            if (goster) goster.textContent = p;
        });
        out.textContent = skor;
        out.parentElement.classList.toggle('tam', skor >= 80);
    }
    form.querySelectorAll('.bess-bulgu').forEach(function (el) { el.addEventListener('change', hesapla); });
    hesapla();

    function slotlar(k) {
        return [document.getElementById('aksiyon-' + k + '-1'),
                document.getElementById('aksiyon-' + k + '-2')];
    }
    function butonGuncelle(k) {
        var btn = form.querySelector('.aksiyon-ata-btn[data-k="' + k + '"]');
        if (!btn) return;
        var acikSayisi = slotlar(k).filter(function (s) { return s && !s.hasAttribute('hidden'); }).length;
        btn.disabled = acikSayisi >= 2;
        btn.textContent = acikSayisi === 0 ? '⚑ Aksiyon Ata'
                        : (acikSayisi === 1 ? '⚑ 2. Aksiyon Ekle' : '⚑ 2 aksiyon eklendi');
        btn.classList.toggle('aktif', acikSayisi > 0);
    }
    form.querySelectorAll('.aksiyon-ata-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var bos = slotlar(btn.dataset.k).find(function (s) { return s && s.hasAttribute('hidden'); });
            if (bos) bos.removeAttribute('hidden');
            butonGuncelle(btn.dataset.k);
        });
    });
    form.querySelectorAll('.aksiyon-kaldir').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var alan = document.getElementById('aksiyon-' + btn.dataset.k + '-' + btn.dataset.slot);
            if (!alan) return;
            alan.querySelectorAll('input').forEach(function (i) { i.value = ''; });
            alan.setAttribute('hidden', '');
            butonGuncelle(btn.dataset.k);
        });
    });
})();
</script>
<%- include('partials/footer') %>
